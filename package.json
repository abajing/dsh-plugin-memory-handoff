{
  "name": "dsh-plugin-memory-handoff",
  "version": "0.1.0",
  "description": "Cross-session memory handoff for DeepSeek Harness: keep progress outside the context, surface unfinished work once per session, and archive compaction summaries so nothing is silently lost.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.mjs",
  "types": "./lib/index.d.mts",
  "files": ["lib/**", "cordis.patch.yml", "README.md", "README.zh.md", "LICENSE"],
  "keywords": ["dsh-plugin", "memory", "session", "compaction", "handoff", "cordis"],
  "exports": {
    ".": { "types": "./lib/index.d.mts", "default": "./lib/index.mjs" },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "scripts": {
    "build": "tsdown && node -e \"require('fs').renameSync('dist/index.mjs','lib/index.mjs')\"",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true }
  }
}
